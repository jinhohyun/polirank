# PoliRank 환경변수 예시
# 실제 값은 .env 에만 넣고 절대 커밋하지 마세요 (.env 는 .gitignore 에 포함되어 있습니다).
# 배포(Vercel)에서는 Project Settings > Environment Variables 에 등록합니다.

# 세션(의원실/운영자) 쿠키 서명키 — 필수 권장.
# 생성: python3 -c "import secrets; print(secrets.token_hex(32))"
POLIRANK_SECRET_KEY=

# 운영자(admin) 초기 비밀번호 — 필수 권장.
# - 설정하면 admin 계정이 이 비밀번호로 생성/동기화됩니다.
# - 미설정 시 하드코딩 기본 비밀번호를 쓰지 않고 관리자 로그인을 비활성화합니다.
POLIRANK_ADMIN_PASSWORD=

# 개발자 후원(커피) 정보 — 선택. 사이트 관리자 화면에서도 수정할 수 있습니다.
DEV_SUPPORT_BANK=
DEV_TOSS_LINK=
DEV_KAKAOPAY_LINK=
